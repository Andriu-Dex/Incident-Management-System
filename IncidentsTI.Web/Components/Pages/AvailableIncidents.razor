@page "/available-incidents"
@using IncidentsTI.Application.Commands
@using IncidentsTI.Application.DTOs
@using IncidentsTI.Application.Queries
@using IncidentsTI.Domain.Enums
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Authorize(Roles = "Administrator,Technician,Pasante")]
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Incidentes Disponibles - Sistema de Incidentes TI</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-green-50 p-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center gap-3 mb-2">
                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                </svg>
                <h1 class="text-3xl font-bold text-gray-900">Incidentes Disponibles</h1>
            </div>
            <p class="text-gray-600">Reclama un incidente para comenzar a trabajar en él</p>
        </div>

        <!-- Stats Card -->
        <div class="bg-white rounded-xl p-6 border-2 border-green-200 shadow-sm mb-8 max-w-xs">
            <div class="flex items-center gap-3">
                <div class="p-3 bg-green-100 rounded-lg">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <div class="text-green-600 text-sm font-semibold">Disponibles</div>
                    <div class="text-3xl font-bold text-gray-900">@availableIncidents.Count()</div>
                </div>
            </div>
        </div>

        <!-- Info Banner -->
        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6 rounded-r-lg">
            <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <p class="text-blue-800 font-medium">Sistema de primer llegado</p>
                    <p class="text-blue-600 text-sm">Al reclamar un incidente, te será asignado automáticamente y solo tú podrás resolverlo.</p>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="flex justify-center items-center py-20">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-600"></div>
            </div>
        }
        else if (!availableIncidents.Any())
        {
            <div class="bg-white rounded-xl p-12 text-center shadow-md border border-gray-200">
                <svg class="w-24 h-24 mx-auto mb-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">¡No hay incidentes disponibles!</h3>
                <p class="text-gray-500">Todos los incidentes están siendo atendidos. Vuelve a revisar más tarde.</p>
            </div>
        }
        else
        {
            <!-- Incidents Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var incident in availableIncidents)
                {
                    <div class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden hover:shadow-lg transition-all duration-300 hover:border-green-300">
                        <!-- Header con prioridad -->
                        <div class="@GetPriorityHeaderClass(incident.Priority) px-6 py-3 flex items-center justify-between">
                            <span class="font-mono text-sm font-bold text-white">@incident.TicketNumber</span>
                            <span class="px-2 py-1 bg-white/20 rounded text-xs font-semibold text-white">
                                @incident.PriorityName
                            </span>
                        </div>
                        
                        <!-- Body -->
                        <div class="p-6">
                            <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2">@incident.Title</h3>
                            <p class="text-gray-500 text-sm mb-4 line-clamp-3">@incident.Description</p>
                            
                            <!-- Info Tags -->
                            <div class="flex flex-wrap gap-2 mb-4">
                                <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">
                                    📁 @incident.ServiceName
                                </span>
                                <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">
                                    🏷️ @incident.TypeName
                                </span>
                            </div>
                            
                            <!-- Footer -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                                <div class="text-xs text-gray-500">
                                    <span>👤 @incident.UserName</span>
                                    <br/>
                                    <span>🕐 @FormatTimeAgo(incident.CreatedAt)</span>
                                </div>
                                <button @onclick="() => ClaimIncident(incident)" 
                                        disabled="@isClaimingId.HasValue"
                                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 
                                               transition-all duration-200 font-semibold text-sm flex items-center gap-2
                                               disabled:bg-gray-400 disabled:cursor-not-allowed">
                                    @if (isClaimingId == incident.Id)
                                    {
                                        <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                                        <span>Reclamando...</span>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"></path>
                                        </svg>
                                        <span>Reclamar</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal de Confirmación -->
@if (showConfirmModal && incidentToClaim != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.5); z-index: 9999;" @onclick="CloseConfirmModal">
        <div style="position: relative; top: 150px; max-width: 450px; margin: 0 auto; background: white; padding: 24px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" @onclick:stopPropagation="true">
            <div class="text-center">
                <div class="mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-green-100 mb-4">
                    <svg class="h-7 w-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"></path>
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">¿Reclamar este incidente?</h3>
                <p class="text-gray-600 mb-2">
                    <strong class="text-green-600">@incidentToClaim.TicketNumber</strong>
                </p>
                <p class="text-gray-500 text-sm mb-6">
                    Al reclamar este incidente serás responsable de su resolución. Solo tú podrás resolverlo.
                </p>
                <div class="flex justify-center gap-3">
                    <button @onclick="CloseConfirmModal" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 font-semibold transition-all duration-200">
                        Cancelar
                    </button>
                    <button @onclick="ConfirmClaim" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 font-semibold transition-all duration-200">
                        Sí, Reclamar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<IncidentDto> availableIncidents = new();
    private bool isLoading = true;
    private int? isClaimingId = null;
    private string currentUserId = string.Empty;
    
    // Modal
    private bool showConfirmModal = false;
    private IncidentDto? incidentToClaim = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadAvailableIncidents();
    }

    private async Task LoadCurrentUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
    }

    private async Task LoadAvailableIncidents()
    {
        isLoading = true;
        try
        {
            var result = await Mediator.Send(new GetAvailableIncidentsQuery());
            availableIncidents = result.ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar incidentes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClaimIncident(IncidentDto incident)
    {
        incidentToClaim = incident;
        showConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        incidentToClaim = null;
    }

    private async Task ConfirmClaim()
    {
        if (incidentToClaim == null) return;
        
        showConfirmModal = false;
        isClaimingId = incidentToClaim.Id;
        
        try
        {
            var command = new ClaimIncidentCommand
            {
                IncidentId = incidentToClaim.Id,
                ClaimedByUserId = currentUserId
            };

            var result = await Mediator.Send(command);

            if (result.Success)
            {
                ToastService.ShowSuccess($"¡Has reclamado el incidente {incidentToClaim.TicketNumber}!");
                // Remover de la lista local
                availableIncidents.RemoveAll(i => i.Id == incidentToClaim.Id);
                StateHasChanged();
                
                // Redirigir al detalle del incidente
                Navigation.NavigateTo($"/incidents/{incidentToClaim.Id}");
            }
            else
            {
                ToastService.ShowError(result.ErrorMessage ?? "No se pudo reclamar el incidente");
                // Recargar la lista por si alguien más lo reclamó
                await LoadAvailableIncidents();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al reclamar: {ex.Message}");
        }
        finally
        {
            isClaimingId = null;
            incidentToClaim = null;
        }
    }

    private string GetPriorityHeaderClass(IncidentPriority priority) => priority switch
    {
        IncidentPriority.Critical => "bg-gradient-to-r from-red-500 to-red-600",
        IncidentPriority.High => "bg-gradient-to-r from-orange-500 to-orange-600",
        IncidentPriority.Medium => "bg-gradient-to-r from-yellow-500 to-yellow-600",
        IncidentPriority.Low => "bg-gradient-to-r from-green-500 to-green-600",
        _ => "bg-gradient-to-r from-gray-500 to-gray-600"
    };

    private string FormatTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
        
        if (timeSpan.TotalMinutes < 1)
            return "Hace un momento";
        if (timeSpan.TotalMinutes < 60)
            return $"Hace {(int)timeSpan.TotalMinutes} min";
        if (timeSpan.TotalHours < 24)
            return $"Hace {(int)timeSpan.TotalHours}h";
        if (timeSpan.TotalDays < 7)
            return $"Hace {(int)timeSpan.TotalDays} días";
        
        return dateTime.ToString("dd/MM/yyyy");
    }
}
