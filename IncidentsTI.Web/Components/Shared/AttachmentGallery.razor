@using IncidentsTI.Application.DTOs
@inject IJSRuntime JSRuntime

<div class="space-y-4">
    @if (Attachments?.Any() == true)
    {
        <!-- Grid de adjuntos -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            @foreach (var attachment in Attachments)
            {
                <div class="group relative bg-white border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition">
                    @if (attachment.IsImage)
                    {
                        <!-- Preview de imagen -->
                        <div class="aspect-square bg-gray-100 cursor-pointer" @onclick="() => OpenLightbox(attachment)">
                            <img src="api/attachments/@attachment.Id/thumbnail" 
                                 alt="@attachment.OriginalFileName"
                                 class="w-full h-full object-cover"
                                 loading="lazy"
                                 onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%23cbd5e1%22><path d=%22M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z%22/></svg>'" />
                            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition flex items-center justify-center">
                                <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                                </svg>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Icono para archivos no-imagen -->
                        <div class="aspect-square bg-gray-50 flex items-center justify-center">
                            <div class="text-center p-4">
                                @GetFileIcon(attachment.ContentType)
                                <p class="text-xs text-gray-500 mt-2">@GetFileExtension(attachment.OriginalFileName)</p>
                            </div>
                        </div>
                    }
                    
                    <!-- Información del archivo -->
                    <div class="p-3">
                        <p class="text-sm font-medium text-gray-800 truncate" title="@attachment.OriginalFileName">
                            @attachment.OriginalFileName
                        </p>
                        <p class="text-xs text-gray-500">@attachment.FormattedSize</p>
                        
                        <!-- Acciones -->
                        <div class="flex items-center justify-between mt-2">
                            <a href="api/attachments/@attachment.Id/download" 
                               download="@attachment.OriginalFileName"
                               class="text-blue-600 hover:text-blue-800 text-sm flex items-center">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                </svg>
                                Descargar
                            </a>
                            
                            @if (CanDelete)
                            {
                                <button type="button" @onclick="() => OnDeleteRequested.InvokeAsync(attachment.Id)"
                                        class="text-red-500 hover:text-red-700 p-1 rounded hover:bg-red-50 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-8 text-gray-500">
            <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
            </svg>
            <p>No hay archivos adjuntos</p>
        </div>
    }

    <!-- Lightbox para imágenes -->
    @if (lightboxAttachment != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-90" @onclick="CloseLightbox">
            <button class="absolute top-4 right-4 text-white hover:text-gray-300 transition z-10" @onclick="CloseLightbox">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
            
            <div class="max-w-4xl max-h-[90vh] p-4" @onclick:stopPropagation>
                <img src="api/attachments/@lightboxAttachment.Id/download" 
                     alt="@lightboxAttachment.OriginalFileName"
                     class="max-w-full max-h-[80vh] object-contain mx-auto rounded shadow-2xl" />
                <div class="text-center mt-4">
                    <p class="text-white font-medium">@lightboxAttachment.OriginalFileName</p>
                    <p class="text-gray-400 text-sm">@lightboxAttachment.FormattedSize • Subido por @lightboxAttachment.UploadedByName</p>
                    <a href="api/attachments/@lightboxAttachment.Id/download" 
                       download="@lightboxAttachment.OriginalFileName"
                       class="inline-flex items-center mt-3 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                        </svg>
                        Descargar original
                    </a>
                </div>
            </div>
            
            <!-- Navegación -->
            @if (Attachments?.Count(a => a.IsImage) > 1)
            {
                var imageAttachments = Attachments.Where(a => a.IsImage).ToList();
                var currentIndex = imageAttachments.IndexOf(lightboxAttachment);
                
                @if (currentIndex > 0)
                {
                    <button class="absolute left-4 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 transition p-2"
                            @onclick:stopPropagation
                            @onclick="() => NavigateLightbox(-1)">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>
                }
                
                @if (currentIndex < imageAttachments.Count - 1)
                {
                    <button class="absolute right-4 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 transition p-2"
                            @onclick:stopPropagation
                            @onclick="() => NavigateLightbox(1)">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<AttachmentDto>? Attachments { get; set; }
    [Parameter] public bool CanDelete { get; set; } = false;
    [Parameter] public EventCallback<int> OnDeleteRequested { get; set; }

    private AttachmentDto? lightboxAttachment;

    private void OpenLightbox(AttachmentDto attachment)
    {
        if (attachment.IsImage)
        {
            lightboxAttachment = attachment;
        }
    }

    private void CloseLightbox()
    {
        lightboxAttachment = null;
    }

    private void NavigateLightbox(int direction)
    {
        if (Attachments == null || lightboxAttachment == null) return;
        
        var imageAttachments = Attachments.Where(a => a.IsImage).ToList();
        var currentIndex = imageAttachments.IndexOf(lightboxAttachment);
        var newIndex = currentIndex + direction;
        
        if (newIndex >= 0 && newIndex < imageAttachments.Count)
        {
            lightboxAttachment = imageAttachments[newIndex];
        }
    }

    private RenderFragment GetFileIcon(string contentType) => contentType switch
    {
        "application/pdf" => @<svg class="w-12 h-12 text-red-500 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>,
        "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" 
            => @<svg class="w-12 h-12 text-blue-600 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6"/></svg>,
        "application/vnd.ms-excel" or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            => @<svg class="w-12 h-12 text-green-600 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6"/></svg>,
        _ => @<svg class="w-12 h-12 text-gray-400 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6"/></svg>
    };

    private string GetFileExtension(string fileName)
    {
        var ext = Path.GetExtension(fileName);
        return string.IsNullOrEmpty(ext) ? "FILE" : ext.ToUpperInvariant().TrimStart('.');
    }
}
